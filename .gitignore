# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
dist/
*.tsbuildinfo

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 运行时数据 / 上传内容（体积大、非源码）----
backend/app/static/
# 多病灶分割权重约 105MB，从压缩包解出，不进仓库
backend/data/multi_lesions/*.pth
*.db
*.sqlite3
*.log

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example

# ---- 小程序打包 ----
miniapp-*/dist/

# ---- 系统 / IDE ----
.DS_Store
Thumbs.db
.idea/
*.swp

# ---- 身份迁移产生的敏感文件 ----
# 迁移脚本会写出用户临时密码明文，分发后应删除，绝不能入库
backend/keycloak-temp-passwords.txt

# ---- 数据库备份（回填脚本执行前自动生成）----
backend/*.db.bak-*

# ---- DICOM 转换产物 ----
# 由 scripts/convert_cases_to_dicom.py 从源影像生成，可随时重跑；
# 体积大且属派生数据，不入库（权威副本在 Orthanc）
backend/app/static/dicom/

# ---- 辅助工具缓存与归档包 ----
.claude/
.pytest_cache/
*.tar.gz
_tmp_feedback/

# ---- 开发期一次性脚本（不入库）----
# scratch/ 用于放未成形/一次性调试脚本，正式测试请使用 backend/tests/ 下 pytest 体系
scratch/


# 发布过程脚本（不入库）
release-v4.5.bat
release-v4.5.ps1
